# ==========================================
# Working / Temporary Data
# ==========================================

# Generated working datasets are reproducible
# and should not be committed by default.
02_Working_Data/*.csv

# Keep the working-data directory itself in the repository.
!02_Working_Data/.gitkeep


# ==========================================
# Raw Data
# ==========================================

# Raw UCI dataset is intentionally kept in this project.
!01_Raw_Data/*.csv


# ==========================================
# Analytical Output Tables
# ==========================================

# Output tables are portfolio artifacts and should be tracked.
!04_Outputs/Tables/*.csv


# ==========================================
# Environment / Secrets
# ==========================================

.env
.venv/
venv/


# ==========================================
# Temporary / Log Files
# ==========================================

*.tmp
*.log